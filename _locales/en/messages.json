  "privacyOverviewHeading": {
    "message": "Overview"
  },
  "privacyOverviewBody": {
    "message": "Ned is a fully offline, client-side browser extension designed for privacy and speed."
  },
  "privacyDataCollectionHeading": {
    "message": "Data Collection"
  },
  "privacyDataCollectionBody": {
    "message": "This extension collects zero personal data, telemetry, or analytics. It does not call external APIs. All CVSS calculations run locally in your browser through embedded JavaScript libraries."
  },
  "privacyPermissionsHeading": {
    "message": "Permissions"
  },
  "privacyPermissionsBody": {
    "message": "The extension uses minimal permissions, including local storage and clipboard copy support when you choose to copy a vector string or CWE ID. It does not track browsing history or read web page content."
  },
  "privacyOpenSourceHeading": {
    "message": "Open Source"
  },
