  "privacyOverviewHeading": {
    "message": "概述"
  },
  "privacyOverviewBody": {
    "message": "Ned 是一个完全离线、在客户端运行的浏览器扩展，重点关注隐私与速度。"
  },
  "privacyDataCollectionHeading": {
    "message": "数据收集"
  },
  "privacyDataCollectionBody": {
    "message": "本扩展不会收集任何个人数据、遥测数据或分析数据，也不会调用任何外部 API。所有 CVSS 计算都通过内置 JavaScript 库在浏览器本地完成。"
  },
  "privacyPermissionsHeading": {
    "message": "权限说明"
  },
  "privacyPermissionsBody": {
    "message": "扩展仅使用最小权限，包括本地存储，以及在你选择复制向量字符串或 CWE ID 时所需的剪贴板复制能力。它不会跟踪浏览历史，也不会读取网页内容。"
  },
  "privacyOpenSourceHeading": {
    "message": "开源"
  },
  "privacyOpenSourcePrefix": {
    "message": "你可以在"
  },
